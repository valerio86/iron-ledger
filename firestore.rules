rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each person can only read and write their own log
    match /users/{uid}/docs/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['p', 'd', 'at', 'del', 'sat'])
        && request.resource.data.p is string && request.resource.data.p.size() < 200
        && (request.resource.data.d == null || (request.resource.data.d is string && request.resource.data.d.size() < 200000))
        && request.resource.data.at is int
        && request.resource.data.sat == request.time;
    }
  }
}
